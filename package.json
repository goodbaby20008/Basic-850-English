{
  "name": "basic-850-learning",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-static-worker.mjs && node scripts/build-portable-package.mjs",
    "preview": "vite preview",
    "start": "npm run preview",
    "test": "npm run validate:data && npm run build && node --test tests/rendered-html.test.mjs tests/alphabet-data.test.mjs tests/word-pictures.test.mjs tests/typing-game.test.mjs tests/portable-package.test.mjs",
    "lint": "eslint . --ignore-pattern dist",
    "validate:data": "node scripts/validate-data.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@openai/sites-vite-plugin": "0.1.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
